  if (
    !server.hasArg(
      "file"
    )
  ) {

    server.send(
      400,
      "text/plain",
      "Parameter file tidak ada"
    );

    return;
  }


  String filename =
    server.arg(
      "file"
    );


  // ==========================================================
  // PROTEKSI PATH
  // ==========================================================

  if (
    !filename.startsWith("/images/") ||
    filename.indexOf("..") >= 0
  ) {

    server.send(
      403,
      "text/plain",
      "Path tidak valid"
    );

    return;
  }


  sendImageFile(
    filename
  );
}


