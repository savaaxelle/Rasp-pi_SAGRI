// ============================================================
// CEK FILE JPEG
// ============================================================

bool isImageFile(String filename) {

  filename.toLowerCase();

  return filename.endsWith(".jpg") ||
         filename.endsWith(".jpeg");
}


// ============================================================
// MEMBUAT ID TANGGAL
// ============================================================
//
// Contoh:
//
// 2026-08-12
//
// menjadi:
//
// 20260812
//

int getDateID(const struct tm &timeinfo) {

  int year =
    timeinfo.tm_year + 1900;

  int month =
    timeinfo.tm_mon + 1;

  int day =
    timeinfo.tm_mday;


  return
    (year * 10000) +
    (month * 100) +
    day;
}


// ============================================================
// AMBIL TIMESTAMP
// ============================================================

bool getTimestamp(
  char* filenameTimestamp,
  size_t filenameSize,
  char* readableTimestamp,
  size_t readableSize
) {

  struct tm timeinfo;


  if (!getLocalTime(&timeinfo, 5000)) {

    Serial.println(
      "[TIME] ERROR: gagal mendapatkan waktu"
    );

    return false;
  }


  // ==========================================================
  // TIMESTAMP UNTUK NAMA FILE
  //
  // contoh:
  // 2026-08-12_05-00-01
  // ==========================================================

  strftime(
    filenameTimestamp,
    filenameSize,
    "%Y-%m-%d_%H-%M-%S",
    &timeinfo
  );


  // ==========================================================
  // TIMESTAMP UNTUK SERIAL
  //
  // contoh:
  // 2026-08-12 05:00:01
  // ==========================================================

  strftime(
    readableTimestamp,
    readableSize,
    "%Y-%m-%d %H:%M:%S",
    &timeinfo
  );


  return true;
}


// ============================================================
// HITUNG JUMLAH FOTO
// ============================================================

int getImageCount() {

  int count = 0;


  File directory =
    LittleFS.open(
      IMAGE_DIRECTORY
    );


  if (
    !directory ||
    !directory.isDirectory()
  ) {

    return 0;
  }


  File file =
    directory.openNextFile();


  while (file) {

    if (!file.isDirectory()) {

      String filename =
        String(file.path());


      if (isImageFile(filename)) {

        count++;
      }
    }


    file.close();


    file =
      directory.openNextFile();
  }


  directory.close();


  return count;
}


// ============================================================
// CARI FOTO TERBARU
// ============================================================

String getLatestImagePath() {

  File directory =
    LittleFS.open(
      IMAGE_DIRECTORY
    );


  if (
    !directory ||
    !directory.isDirectory()
  ) {

    Serial.println(
      "[LATEST] Directory /images tidak ditemukan"
    );

    return "";
  }


  String latestFile = "";


  File file =
    directory.openNextFile();


  while (file) {

    if (!file.isDirectory()) {

      // ======================================================
      // FULL PATH
      // ======================================================

      String filename =
        String(file.path());


      if (isImageFile(filename)) {

        if (
          latestFile.length() == 0 ||
          filename > latestFile
        ) {

          latestFile =
            filename;
        }
      }
    }


    file.close();


    file =
      directory.openNextFile();
  }


  directory.close();


  Serial.print(
    "[LATEST] Dipilih: "
  );

  Serial.println(
    latestFile
  );


  return latestFile;
}


// ============================================================
// BUAT NAMA FILE UNIK
// ============================================================

String createUniqueFilename(
  const char* timestamp
) {

  String base =
    String(IMAGE_DIRECTORY) +
    "/" +
    timestamp;


  String filename =
    base +
    ".jpg";


  if (!LittleFS.exists(filename)) {

    return filename;
  }


  // ==========================================================
  // Jika ada capture dua kali pada detik yang sama
  // ==========================================================

  for (
    int i = 1;
    i <= 99;
    i++
  ) {

    String candidate =
      base +
      "_" +
      String(i) +
      ".jpg";


    if (!LittleFS.exists(candidate)) {

      return candidate;
    }
  }


  return "";
}


// ============================================================
// CAPTURE + SIMPAN FOTO
// ============================================================

bool captureAndSaveImage(
  String &savedPath
) {

  savedPath = "";


  Serial.println();
  Serial.println(
    "=========================================="
  );

  Serial.println(
    "[CAM] MEMULAI CAPTURE"
  );

  Serial.println(
    "=========================================="
  );


  // ==========================================================
  // TIMESTAMP
  // ==========================================================

  char filenameTimestamp[32];

  char readableTimestamp[32];


  if (
    !getTimestamp(
      filenameTimestamp,
      sizeof(filenameTimestamp),

      readableTimestamp,
      sizeof(readableTimestamp)
    )
  ) {

    Serial.println(
      "[CAM] Capture dibatalkan: timestamp gagal"
    );

    return false;
  }


  Serial.print(
    "[TIME] "
  );

  Serial.println(
    readableTimestamp
  );


  // ==========================================================
  // CAPTURE FRAME
  // ==========================================================

  uint32_t captureStart =
    millis();


  camera_fb_t* fb =
    esp_camera_fb_get();


  if (!fb) {

    Serial.println(
      "[CAM] ERROR: gagal mengambil frame"
    );

    return false;
  }


  Serial.println(
    "[CAM] Capture berhasil"
  );


  Serial.print(
    "[CAM] Resolusi : "
  );

  Serial.print(
    fb->width
  );

  Serial.print(
    " x "
  );

  Serial.println(
    fb->height
  );


  Serial.print(
    "[CAM] JPEG size : "
  );

  Serial.print(
    fb->len
  );

  Serial.println(
    " byte"
  );


  // ==========================================================
  // NAMA FILE
  // ==========================================================

  String filename =
    createUniqueFilename(
      filenameTimestamp
    );


  if (filename.length() == 0) {

    Serial.println(
      "[FILE] ERROR: gagal membuat nama file"
    );

    esp_camera_fb_return(fb);

    return false;
  }


  Serial.print(
    "[FILE] Menyimpan: "
  );

  Serial.println(
    filename
  );


  // ==========================================================
  // BUKA FILE
  // ==========================================================

  File imageFile =
    LittleFS.open(
      filename,
      FILE_WRITE
    );


  if (!imageFile) {

    Serial.println(
      "[FILE] ERROR: gagal membuka file"
    );

    esp_camera_fb_return(fb);

    return false;
  }


  size_t imageSize =
    fb->len;


  // ==========================================================
  // SIMPAN JPEG
  // ==========================================================

  size_t written =
    imageFile.write(
      fb->buf,
      imageSize
    );


  imageFile.close();


  // ==========================================================
  // KEMBALIKAN FRAMEBUFFER
  // ==========================================================

  esp_camera_fb_return(fb);


  // ==========================================================
  // VALIDASI
  // ==========================================================

  if (written != imageSize) {

    Serial.println(
      "[FILE] ERROR: file tidak tertulis sempurna"
    );


    Serial.print(
      "[FILE] Expected: "
    );

    Serial.println(
      imageSize
    );


    Serial.print(
      "[FILE] Written : "
    );

    Serial.println(
      written
    );


    LittleFS.remove(
      filename
    );


    return false;
  }


  savedPath =
    filename;


  uint32_t duration =
    millis() - captureStart;


  Serial.println();
  Serial.println(
    "[OK] FOTO BERHASIL DISIMPAN"
  );


  Serial.print(
    "[FILE] "
  );

  Serial.println(
    filename
  );


  Serial.print(
    "[TIME] "
  );

  Serial.println(
    readableTimestamp
  );


  Serial.print(
    "[SIZE] "
  );

  Serial.print(
    imageSize
  );

  Serial.println(
    " byte"
  );


  Serial.print(
    "[PROCESS] "
  );

  Serial.print(
    duration
  );

  Serial.println(
    " ms"
  );


  Serial.print(
    "[STORAGE] Jumlah foto sekarang: "
  );

  Serial.println(
    getImageCount()
  );


  Serial.print(
    "[FS] Used : "
  );

  Serial.print(
    LittleFS.usedBytes()
  );

  Serial.println(
    " byte"
  );


  Serial.print(
    "[FS] Total: "
  );

  Serial.print(
    LittleFS.totalBytes()
  );

  Serial.println(
    " byte"
  );


  Serial.println(
    "=========================================="
  );


  return true;
}


// ============================================================
// KIRIM FOTO KE RASPBERRY PI
// ============================================================
//
// Membaca file JPEG dari LittleFS lalu mem-POST isinya ke
// esp_cam_receiver.py di Raspberry Pi (endpoint /upload).
//

bool uploadImageToRaspberryPi(const String &path) {

  if (WiFi.status() != WL_CONNECTED) {

    Serial.println(
      "[UPLOAD] DILEWATI: WiFi tidak terhubung"
    );

    return false;
  }


  File file =
    LittleFS.open(
      path,
      FILE_READ
    );


  if (!file) {

    Serial.println(
      "[UPLOAD] ERROR: gagal membuka file untuk upload"
    );

    return false;
  }


  size_t fileSize =
    file.size();


  uint8_t* buffer =
    (uint8_t*) malloc(fileSize);


  if (!buffer) {

    Serial.println(
      "[UPLOAD] ERROR: gagal alokasi buffer upload"
    );

    file.close();

    return false;
  }


  file.read(buffer, fileSize);

  file.close();


  String url =
    String("http://") +
    raspberryPiHost +
    ":" +
    String(raspberryPiPort) +
    "/upload";


  Serial.println();
  Serial.println(
    "=========================================="
  );

  Serial.println(
    "[UPLOAD] Mengirim foto ke Raspberry Pi"
  );

  Serial.print(
    "[UPLOAD] URL: "
  );

  Serial.println(
    url
  );


  HTTPClient http;

  http.begin(url);

  http.addHeader(
    "Content-Type",
    "image/jpeg"
  );

  http.addHeader(
    "X-Camera-ID",
    raspberryPiCameraId
  );


  int statusCode =
    http.POST(
      buffer,
      fileSize
    );


  free(buffer);


  if (statusCode <= 0) {

    Serial.print(
      "[UPLOAD] GAGAL: "
    );

    Serial.println(
      HTTPClient::errorToString(statusCode)
    );

    http.end();

    return false;
  }


  String response =
    http.getString();

  Serial.print(
    "[UPLOAD] HTTP status: "
  );

  Serial.println(
    statusCode
  );

  Serial.print(
    "[UPLOAD] Response  : "
  );

  Serial.println(
    response
  );


  http.end();


  bool success =
    (statusCode == 200);


  if (success) {

    Serial.println(
      "[UPLOAD] BERHASIL"
    );

  } else {

    Serial.println(
      "[UPLOAD] GAGAL: server menolak gambar"
    );
  }


  Serial.println(
    "=========================================="
  );


  return success;
}


// ============================================================
// HAPUS SEMUA FOTO
// ============================================================

bool deleteAllImages() {

  Serial.println();
  Serial.println(
    "=========================================="
  );

  Serial.println(
    "[DAILY RESET] MENGHAPUS SEMUA FOTO"
  );

  Serial.println(
    "=========================================="
  );


  File directory =
    LittleFS.open(
      IMAGE_DIRECTORY
    );


  if (
    !directory ||
    !directory.isDirectory()
  ) {

    Serial.println(
      "[DAILY RESET] ERROR: /images tidak dapat dibuka"
    );

    return false;
  }


  // ==========================================================
  // Simpan daftar nama file dahulu.
  //
  // Disediakan 32 slot supaya jika masih ada foto dari
  // program versi lama semuanya bisa dibersihkan.
  // ==========================================================

  String filesToDelete[32];

  int fileCount = 0;


  File file =
    directory.openNextFile();


  while (
    file &&
    fileCount < 32
  ) {

    if (!file.isDirectory()) {

      String filename =
        String(file.path());


      if (isImageFile(filename)) {

        filesToDelete[fileCount] =
          filename;

        fileCount++;
      }
    }


    file.close();


    file =
      directory.openNextFile();
  }


  directory.close();


  Serial.print(
    "[DAILY RESET] Jumlah foto ditemukan: "
  );

  Serial.println(
    fileCount
  );


  // ==========================================================
  // HAPUS FILE SATU PER SATU
  // ==========================================================

  int deletedCount = 0;


  for (
    int i = 0;
    i < fileCount;
    i++
  ) {

    Serial.print(
      "[DELETE] "
    );

    Serial.println(
      filesToDelete[i]
    );


    if (
      LittleFS.remove(
        filesToDelete[i]
      )
    ) {

      deletedCount++;

      Serial.println(
        "         BERHASIL"
      );

    }

    else {

      Serial.println(
        "         GAGAL"
      );
    }
  }


  Serial.print(
    "[DAILY RESET] Terhapus: "
  );

  Serial.print(
    deletedCount
  );

  Serial.print(
    "/"
  );

  Serial.println(
    fileCount
  );


  Serial.println(
    "=========================================="
  );


  return deletedCount == fileCount;
}


// ============================================================
// CEK PERGANTIAN HARI
// ============================================================
//
// Tidak hanya memeriksa pukul 00:00.
//
// Contoh:
//
// ESP mati 23:50
// ESP hidup lagi 02:00
//
// Setelah NTP tersinkron,
// ESP tetap mengetahui bahwa tanggal telah berubah
// dan akan menghapus foto kemarin.
//

void checkDailyCleanup() {

  struct tm timeinfo;


  if (
    !getLocalTime(
      &timeinfo,
      1000
    )
  ) {

    return;
  }


  int currentDate =
    getDateID(
      timeinfo
    );


  // ==========================================================
  // SUDAH DIBERSIHKAN HARI INI
  // ==========================================================

  if (
    lastCleanupDate ==
    currentDate
  ) {

    return;
  }


  // ==========================================================
  // HARI BARU
  // ==========================================================

  Serial.println();
  Serial.println(
    "##########################################"
  );

  Serial.println(
    "[DAILY RESET] HARI BARU TERDETEKSI"
  );


  Serial.printf(
    "[DAILY RESET] %04d-%02d-%02d %02d:%02d:%02d\n",

    timeinfo.tm_year + 1900,
    timeinfo.tm_mon + 1,
    timeinfo.tm_mday,

    timeinfo.tm_hour,
    timeinfo.tm_min,
    timeinfo.tm_sec
  );


  Serial.println(
    "##########################################"
  );


  // ==========================================================
  // HAPUS FOTO
  // ==========================================================

  if (
    deleteAllImages()
  ) {

    lastCleanupDate =
      currentDate;


    preferences.putInt(
      "lastCleanup",
      currentDate
    );


    Serial.println(
      "[DAILY RESET] Storage siap untuk hari baru"
    );

  }

  else {

    Serial.println(
      "[DAILY RESET] Cleanup GAGAL"
    );

    Serial.println(
      "[DAILY RESET] Akan dicoba lagi"
    );
  }
}


// ============================================================
// KIRIM JPEG MELALUI HTTP
// ============================================================

void sendImageFile(
  String filename
) {

  Serial.println();
  Serial.println(
    "=========================================="
  );

  Serial.println(
    "[HTTP IMAGE] REQUEST"
  );


  Serial.print(
    "[HTTP IMAGE] Path: "
  );

  Serial.println(
    filename
  );


  // ==========================================================
  // VALIDASI
  // ==========================================================

  if (filename.length() == 0) {

    server.send(
      404,
      "text/plain",
      "Filename kosong"
    );

    return;
  }


  if (
    !filename.startsWith(
      IMAGE_DIRECTORY
    )
  ) {

    server.send(
      403,
      "text/plain",
      "Path tidak valid"
    );

    return;
  }


  if (!LittleFS.exists(filename)) {

    server.send(
      404,
      "text/plain",
      "Image tidak ditemukan"
    );

    return;
  }


  File file =
    LittleFS.open(
      filename,
      FILE_READ
    );


  if (!file) {

    server.send(
      500,
      "text/plain",
      "Gagal membuka image"
    );

    return;
  }


  size_t fileSize =
    file.size();


  Serial.print(
    "[HTTP IMAGE] File size: "
  );

  Serial.print(
    fileSize
  );

  Serial.println(
    " byte"
  );


  // ==========================================================
  // NONAKTIFKAN CACHE
  // ==========================================================

  server.sendHeader(
    "Cache-Control",
    "no-store, no-cache, must-revalidate"
  );


  // ==========================================================
  // STREAM FILE
  // ==========================================================

  size_t sent =
    server.streamFile(
      file,
      "image/jpeg"
    );


  file.close();


  Serial.print(
    "[HTTP IMAGE] Sent: "
  );

  Serial.print(
    sent
  );

  Serial.println(
    " byte"
  );


  if (sent == fileSize) {

    Serial.println(
      "[HTTP IMAGE] BERHASIL"
    );

  }

  else {

    Serial.println(
      "[HTTP IMAGE] WARNING: jumlah byte berbeda"
    );
  }


  Serial.println(
    "=========================================="
  );
}


