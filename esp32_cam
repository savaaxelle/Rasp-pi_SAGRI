    "[HTTP] Membuka gallery"
  );


  // Normalnya 3 foto/hari.
  // Tetapi disediakan ruang tambahan untuk capture manual.

  const int MAX_GALLERY_FILES = 32;


  String files[
    MAX_GALLERY_FILES
  ];


  int count = 0;


  File directory =
    LittleFS.open(
      IMAGE_DIRECTORY
    );


  if (
    directory &&
    directory.isDirectory()
  ) {

    File file =
      directory.openNextFile();


    while (
      file &&
      count < MAX_GALLERY_FILES
    ) {

      if (!file.isDirectory()) {

        // Full path
        String filename =
          String(file.path());


        if (isImageFile(filename)) {

          files[count] =
            filename;

          count++;
        }
      }


      file.close();


      file =
        directory.openNextFile();
    }


    directory.close();
  }


  // ==========================================================
  // SORT TERBARU → TERLAMA
  // ==========================================================

  for (
    int i = 0;
    i < count - 1;
    i++
  ) {

    for (
      int j = i + 1;
      j < count;
      j++
    ) {

      if (
        files[j] >
        files[i]
      ) {

        String temp =
          files[i];


        files[i] =
          files[j];


        files[j] =
          temp;
      }
    }
  }


  // ==========================================================
  // HTML
  // ==========================================================

  String html =
    "<!DOCTYPE html>"
    "<html>"
    "<head>"
    "<meta name='viewport' "
    "content='width=device-width,initial-scale=1'>"
    "<title>ESP32 Gallery</title>"
    "<style>"
    "body{font-family:Arial;background:#111;color:white;text-align:center;}"
    "img{max-width:95%;width:640px;border-radius:8px;}"
    "a{color:#66bbff;}"
    ".photo{margin-bottom:40px;}"
    "</style>"
    "</head>"
    "<body>";


  html +=
    "<h1>Foto Hari Ini</h1>";


  html +=
    "<p>Total foto: " +
    String(count) +
    "</p>";


  html +=
    "<p><a href='/'>Kembali ke Home</a></p>";


  // ==========================================================
  // TAMPILKAN FOTO
  // ==========================================================

  for (
    int i = 0;
    i < count;
    i++
  ) {

    String displayName =
      files[i];


    displayName.replace(
      "/images/",
      ""
    );


    displayName.replace(
      ".jpg",
      ""
    );


    displayName.replace(
      "_",
      " "
    );


    html +=
      "<div class='photo'>";


    html +=
      "<h3>" +
      displayName +
      "</h3>";


    html +=
      "<img src='/image?file=" +
      files[i] +
      "'>";


    html +=
      "</div>";
  }


  if (count == 0) {

    html +=
      "<p>Belum ada foto hari ini.</p>";
  }


  html +=
    "</body></html>";


  server.send(
    200,
    "text/html",
    html
  );
}


// ============================================================
// SETUP CAMERA
// ============================================================

bool setupCamera() {

  camera_config_t config = {};


  config.ledc_channel =
    LEDC_CHANNEL_0;


  config.ledc_timer =
    LEDC_TIMER_0;


  // ==========================================================
  // DATA PIN
  // ==========================================================

  config.pin_d0 =
    Y2_GPIO_NUM;

  config.pin_d1 =
    Y3_GPIO_NUM;

  config.pin_d2 =
    Y4_GPIO_NUM;

  config.pin_d3 =
    Y5_GPIO_NUM;

  config.pin_d4 =
    Y6_GPIO_NUM;

  config.pin_d5 =
    Y7_GPIO_NUM;

  config.pin_d6 =
    Y8_GPIO_NUM;

  config.pin_d7 =
    Y9_GPIO_NUM;


  // ==========================================================
  // CLOCK / SYNC
  // ==========================================================

  config.pin_xclk =
    XCLK_GPIO_NUM;


  config.pin_pclk =
    PCLK_GPIO_NUM;


  config.pin_vsync =
    VSYNC_GPIO_NUM;


  config.pin_href =
    HREF_GPIO_NUM;


  // ==========================================================
  // SCCB
  // ==========================================================

  config.pin_sccb_sda =
    SIOD_GPIO_NUM;


  config.pin_sccb_scl =
    SIOC_GPIO_NUM;


  // ==========================================================
  // POWER
  // ==========================================================

  config.pin_pwdn =
    PWDN_GPIO_NUM;


  config.pin_reset =
    RESET_GPIO_NUM;


  // ==========================================================
  // OV2640 CLOCK
  // ==========================================================

  config.xclk_freq_hz =
    20000000;


  config.pixel_format =
    PIXFORMAT_JPEG;


  // ==========================================================
  // PSRAM
  // ==========================================================

  if (psramFound()) {

    Serial.println(
      "[CAM] PSRAM ditemukan"
    );


    config.frame_size =
      FRAMESIZE_VGA;


    config.jpeg_quality =
      10;


    config.fb_count =
      2;


    config.grab_mode =
      CAMERA_GRAB_LATEST;


    config.fb_location =
      CAMERA_FB_IN_PSRAM;

  }

  else {

    Serial.println(
      "[CAM] WARNING: PSRAM tidak ditemukan"
    );


    config.frame_size =
      FRAMESIZE_QVGA;


    config.jpeg_quality =
      12;


    config.fb_count =
      1;


    config.grab_mode =
      CAMERA_GRAB_WHEN_EMPTY;


    config.fb_location =
      CAMERA_FB_IN_DRAM;
  }


  // ==========================================================
  // INIT
  // ==========================================================

  esp_err_t error =
    esp_camera_init(
      &config
    );


  if (
    error != ESP_OK
  ) {

    Serial.printf(
      "[CAM] ERROR init: 0x%x\n",
      error
    );


    return false;
  }


  Serial.println(
    "[CAM] Kamera berhasil diinisialisasi"
  );


  // ==========================================================
  // SENSOR INFO
  // ==========================================================

  sensor_t* sensor =
    esp_camera_sensor_get();


  if (
    sensor != nullptr
  ) {

    Serial.print(
      "[CAM] Sensor PID: 0x"
    );


    Serial.println(
      sensor->id.PID,
      HEX
    );
  }


  return true;
}


// ============================================================
// EKSEKUSI CAPTURE TERJADWAL
// ============================================================

void performScheduledCapture(
  const char* scheduleName,
  int currentDate,
  int &lastDate,
  const char* preferenceKey
) {

  Serial.println();
  Serial.println(
    "##########################################"
  );


  Serial.print(
    "[SCHEDULE] CAPTURE "
  );

  Serial.println(
    scheduleName
  );


  Serial.println(
    "##########################################"
  );


  String savedImage;


  if (
    captureAndSaveImage(
      savedImage
    )
  ) {

    Serial.print(
      "[SCHEDULE] Capture "
    );

    Serial.print(
      scheduleName
    );

    Serial.println(
      " BERHASIL"
    );


    // ========================================================
    // KIRIM KE RASPBERRY PI
    // ========================================================

    uploadImageToRaspberryPi(
      savedImage
    );


    // ========================================================
    // UPDATE RAM
    // ========================================================

    lastDate =
      currentDate;


    // ========================================================
    // SIMPAN KE NVS
    // ========================================================

    preferences.putInt(
      preferenceKey,
      currentDate
    );

  }

  else {

    Serial.print(
      "[SCHEDULE] Capture "
    );

    Serial.print(
      scheduleName
    );

    Serial.println(
      " GAGAL"
    );
  }
}


// ============================================================
// CEK JADWAL
// ============================================================

void checkScheduledCapture() {

  struct tm timeinfo;


  if (
    !getLocalTime(
      &timeinfo,
      1000
    )
  ) {

    return;
  }


  int currentHour =
    timeinfo.tm_hour;


  int currentMinute =
    timeinfo.tm_min;


  int currentDate =
    getDateID(
      timeinfo
    );


  // ==========================================================
  // CAPTURE HANYA PADA MENIT 00
  //
  // Loop berjalan tiap 500 ms sehingga tidak masalah jika
  // detiknya 00, 01, 02, dst.
  //
  // NVS mencegah capture berulang selama menit tersebut.
  // ==========================================================

  if (
    currentMinute != 0
  ) {

    return;
  }


  // ==========================================================
  // 05:00
  // ==========================================================

  if (
    currentHour == 5 &&
    lastCaptureDate05 != currentDate
  ) {

    performScheduledCapture(
      "05:00",
      currentDate,
      lastCaptureDate05,
      "last05"
    );


    return;
  }


  // ==========================================================
  // 12:00
  // ==========================================================

  if (
    currentHour == 12 &&
    lastCaptureDate12 != currentDate
  ) {

    performScheduledCapture(
      "12:00",
      currentDate,
      lastCaptureDate12,
      "last12"
    );


    return;
  }


  // ==========================================================
  // 17:00
  // ==========================================================

  if (
    currentHour == 17 &&
    lastCaptureDate17 != currentDate
  ) {

    performScheduledCapture(
      "17:00",
      currentDate,
      lastCaptureDate17,
      "last17"
    );


    return;
  }
}


